# Copy to .env for local development. On Railway, set these in the service's
# Variables tab instead. Never commit real values. Full guide: docs/BACKEND.md

# Railway sets PORT automatically. Locally the API runs on 8080.
PORT=8080
NODE_ENV=development

# Persistent storage for the SQLite database and uploaded images.
# Railway: attach a volume at /data and set DATA_DIR=/data. Local: leave blank (uses ./storage).
DATA_DIR=

# The public URL of this API (used to build image links), without a trailing slash.
# Railway example: https://ieee-sooners-api.up.railway.app
PUBLIC_API_URL=http://localhost:8080

# Website origins allowed to call the API, comma-separated (scheme + host only, no path).
ALLOWED_ORIGINS=http://localhost:4317,http://127.0.0.1:4317,https://liamhoweth.github.io

# Where the site and its admin page live (used in emails).
SITE_URL=http://localhost:4317
ADMIN_URL=http://localhost:4317/admin

# First owner account. Used only when no admins exist yet, then ignored.
# Generate the hash with: npm run hash-password
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD_HASH=

# Optional email (sponsor alerts + password resets). Gmail: turn on 2-Step
# Verification, create an App Password, and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Who gets sponsor alerts. Blank = every active admin's email.
NOTIFY_EMAILS=
