{
  "name": "ieee-sooners-api",
  "version": "1.0.0",
  "private": true,
  "description": "IEEE Sooners admin and content API (Railway service).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "dev": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --disable-warning=ExperimentalWarning --test \"dist/test/*.test.js\"",
    "hash-password": "node scripts/hash-password.mjs",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.mjs",
    "set-password": "node --disable-warning=ExperimentalWarning scripts/set-password.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.9.3"
  }
}
