# Serves the prerendered site (dist/client, copied to /srv) on Railway.
# Based on Railpack's static-site template, plus clean URLs (/about -> about.html),
# long caching for hashed assets, and short caching for pages so deploys show at once.
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	# Railway health check (healthcheckPath in server/.railway/railway.ts).
	respond /health 200

	root * {$SITE_ROOT:/srv}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# The API, uploaded images, the Google Calendar embed and YouTube/Vimeo post videos are
		# all https://, so they are allowed by scheme. No inline-script removal: Vinext inlines its
		# bootstrap scripts.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; connect-src 'self' https:; media-src 'self' https:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Content-hashed files never change.
	@hashed path /_next/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (HTML, favicons) revalidates so a new deploy shows right away.
	@unhashed not path /_next/static/*
	header @unhashed Cache-Control "public, max-age=0, must-revalidate"

	@rsc path *.rsc
	header @rsc Content-Type "text/x-component"

	# GitHub Pages-era links (/about.html) and clean links (/about) both work.
	try_files {path} {path}.html {path}/index.html

	encode zstd gzip

	file_server {
		hide .git .env*
	}

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
